## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# CMake build directories
/build/
/build-*/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
CTestTestfile.cmake
cmake_install.cmake
compile_commands.json

# Generated Visual Studio files from CMake
*.sln
*.slnx
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build output
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]in/
[Oo]bj/

# Visual Studio cache
.vs/

# C++ generated files
*.obj
*.pdb
*.ilk
*.pch
*.ipdb
*.iobj
*.log

# Python
__pycache__/
*.pyc

# OS files
.DS_Store
Thumbs.db
